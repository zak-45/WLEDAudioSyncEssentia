{
  "_meta": {
    "name": "ambient",
    "description": "Ambient profile Effects",
    "version": 1
  },
  "thresholds": {
    "high_arousal": 0.3,
    "low_arousal": -0.3,
    "positive_valence": 0.1,
    "negative_valence": -0.1
  },
  "effects": {
    "calm": {
      "condition": "arousal <= low_arousal and valence >= positive_valence",
      "effect": "Aurora",
      "index": 2
    },
    "sad": {
      "condition": "arousal <= low_arousal and valence <= negative_valence",
      "effect": "Fade",
      "index": 3
    },
    "neutral": {
      "condition": "True",
      "effect": "Solid",
      "index": 4
    }
  }
}
