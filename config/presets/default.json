{
  "thresholds": {
    "high_arousal": 0.4,
    "low_arousal": -0.4,
    "positive_valence": 0.2,
    "negative_valence": -0.2
  },

  "effects": {
    "joy": {
      "condition": "arousal >= high_arousal and valence >= positive_valence",
      "effect": "Chase"
    },
    "anger": {
      "condition": "arousal >= high_arousal and valence <= negative_valence",
      "effect": "Fire"
    },
    "calm": {
      "condition": "arousal <= low_arousal and valence >= positive_valence",
      "effect": "Fade"
    },
    "sadness": {
      "condition": "arousal <= low_arousal and valence <= negative_valence",
      "effect": "Twinkle"
    },
    "neutral": {
      "condition": "True",
      "effect": "Solid"
    }
  }
}
